# Postgres connection string. For Supabase use the *Transaction pooler* string (port 6543),
# e.g. postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres Leave empty locally
# to use an embedded database stored in ./.data (zero setup).
DATABASE_URL=

# Random string used to sign login cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=

# First-run admin account (only used when the users table is empty).
ADMIN_EMAIL=admin@zetdc.co.zw
ADMIN_PASSWORD=Admin@123

# Public address of the site (used for link previews).
NEXT_PUBLIC_SITE_URL=https://faults.emura.co.zw
