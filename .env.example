# Postgres connection string (Neon / Vercel Postgres / Supabase). Leave empty locally
# to use an embedded database stored in ./.data (zero setup).
DATABASE_URL=

# Random string used to sign login cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=

# First-run admin account (only used when the users table is empty).
ADMIN_EMAIL=admin@zetdc.co.zw
ADMIN_PASSWORD=Admin@123
